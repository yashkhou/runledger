{
  "name": "runledger",
  "version": "0.6.0",
  "description": "Tamper-evident local execution ledger for AI agents: hash-chained tool calls, decisions, retries, results and verifiable HTML reports.",
  "type": "module",
  "bin": {
    "runledger": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/core.test.js dist/flight-recorder.test.js dist/adapters.test.js dist/policy.test.js dist/attestation.test.js"
  },
  "keywords": [
    "ai-agents",
    "agent-observability",
    "agent-debugging",
    "audit-log",
    "provenance",
    "tamper-evident",
    "hash-chain",
    "execution-trace",
    "agentic-ai",
    "mcp",
    "local-first",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashkhou/runledger.git"
  },
  "homepage": "https://yashkhou.com/projects/runledger",
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "author": {
    "name": "Yash",
    "url": "https://github.com/yashkhou"
  },
  "bugs": {
    "url": "https://github.com/yashkhou/runledger/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
